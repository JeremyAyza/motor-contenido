{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1,
      "description": "Id de la cuenta en accounts/*.json"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "infoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Fecha a la que corresponde la información"
    },
    "idea": {
      "type": "string",
      "minLength": 10,
      "description": "La idea propia de esta pieza: 'En este carrusel, [algo del tema] se vuelve [recurso visual]'"
    },
    "art": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "titular-gigante",
            "terminal",
            "captura-anotada",
            "antes-despues",
            "linea-continua",
            "capa-por-capa",
            "ficha-tecnica",
            "diario-de-prueba",
            "chat",
            "collage",
            "elige-tu-camino",
            "personaje"
          ],
          "description": "Dirección de arte base, elegida de la mano que repartió `npm run carrusel:baraja`"
        },
        "dealt": {
          "description": "Las direcciones que te tocaron en la baraja",
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "titular-gigante",
              "terminal",
              "captura-anotada",
              "antes-despues",
              "linea-continua",
              "capa-por-capa",
              "ficha-tecnica",
              "diario-de-prueba",
              "chat",
              "collage",
              "elige-tu-camino",
              "personaje"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "description": "Por qué esta dirección sirve a este tema mejor que las otras que te tocaron"
        },
        "borrowed": {
          "default": [],
          "description": "Direcciones de las que alguna lámina interior toma la forma (con la misma paleta y tipografías)",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "titular-gigante",
              "terminal",
              "captura-anotada",
              "antes-despues",
              "linea-continua",
              "capa-por-capa",
              "ficha-tecnica",
              "diario-de-prueba",
              "chat",
              "collage",
              "elige-tu-camino",
              "personaje"
            ]
          }
        },
        "palette": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Fondo base"
            },
            "ink": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Texto sobre el fondo base"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Color de acento; suele salir del ancla visual"
            },
            "accentInk": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Texto sobre el acento"
            },
            "surface": {
              "description": "Fondo de bloques y tarjetas; si falta, se mezcla tinta y fondo",
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "muted": {
              "description": "Notas secundarias; si falta, se mezcla tinta y fondo",
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "bg",
            "ink",
            "accent",
            "accentInk"
          ]
        },
        "fonts": {
          "type": "object",
          "properties": {
            "display": {
              "type": "string",
              "enum": [
                "geist",
                "archivo",
                "instrument-serif",
                "fraunces",
                "bricolage",
                "caveat"
              ],
              "description": "Titulares"
            },
            "text": {
              "default": "geist",
              "description": "Texto corrido",
              "type": "string",
              "enum": [
                "geist",
                "archivo",
                "instrument-serif",
                "fraunces",
                "bricolage",
                "caveat"
              ]
            },
            "notes": {
              "description": "Anotaciones a mano (caveat), solo si la dirección las usa",
              "type": "string",
              "enum": [
                "geist",
                "archivo",
                "instrument-serif",
                "fraunces",
                "bricolage",
                "caveat"
              ]
            }
          },
          "required": [
            "display"
          ]
        },
        "anchor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "logo",
                "captura",
                "icono",
                "imagen"
              ],
              "description": "logo: ícono oficial de una marca; captura: pantalla real; icono: objeto genérico (Lucide); imagen: foto o recurso de prensa con licencia"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Slug de Simple Icons, nombre del ícono de Lucide o archivo de la pieza"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "De dónde sale y con qué licencia o permiso"
            }
          },
          "required": [
            "kind",
            "ref",
            "source"
          ],
          "description": "El elemento que dice el tema sin leer; va grande en la portada"
        },
        "tab": {
          "description": "Texto de la pestaña del marco; por defecto, el tema de la carpeta + .md",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "direction",
        "reason",
        "palette",
        "fonts",
        "anchor"
      ]
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2200,
      "description": "Texto principal del post"
    },
    "slideCaptions": {
      "description": "Un texto por lámina (opción de Instagram desde junio de 2026)",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "title",
          "url",
          "checkedAt"
        ]
      }
    }
  },
  "required": [
    "account",
    "topic",
    "infoDate",
    "idea",
    "art",
    "caption",
    "sources"
  ]
}
