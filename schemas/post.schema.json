{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1,
      "description": "Id de la cuenta en accounts/*.json"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "infoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Fecha a la que corresponde la información"
    },
    "idea": {
      "type": "string",
      "minLength": 10,
      "description": "La idea propia de esta pieza: 'En este carrusel, [algo del tema] se vuelve [recurso visual]'"
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2200,
      "description": "Texto principal del post"
    },
    "slideCaptions": {
      "description": "Un texto por lámina (opción de Instagram desde junio de 2026)",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "title",
          "url",
          "checkedAt"
        ]
      }
    }
  },
  "required": [
    "account",
    "topic",
    "infoDate",
    "idea",
    "caption",
    "sources"
  ]
}
