{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1,
      "description": "Id de la cuenta en accounts/*.json"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "infoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Fecha a la que corresponde la información"
    },
    "slides": {
      "minItems": 3,
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "cover"
              },
              "kicker": {
                "description": "Línea pequeña sobre el título, p. ej. la fecha del lanzamiento",
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 70,
                "description": "Promesa concreta, 8 palabras como máximo"
              },
              "highlight": {
                "description": "Fragmento literal del título que va en color de acento",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "terminal": {
                "description": "Líneas de terminal decorativas que muestran algo real",
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                }
              }
            },
            "required": [
              "type",
              "title"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "concept"
              },
              "eyebrow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              },
              "flow": {
                "description": "Diagrama horizontal de 2 o 3 cajas",
                "minItems": 2,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 28
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    }
                  },
                  "required": [
                    "label"
                  ]
                }
              }
            },
            "required": [
              "type",
              "title",
              "body"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "list"
              },
              "eyebrow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "items": {
                "minItems": 2,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 90
                    }
                  },
                  "required": [
                    "label"
                  ]
                }
              }
            },
            "required": [
              "type",
              "title",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "steps"
              },
              "eyebrow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "steps": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "code": {
                      "description": "Comando o fragmento corto en monoespaciada",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    }
                  },
                  "required": [
                    "title"
                  ]
                }
              }
            },
            "required": [
              "type",
              "title",
              "steps"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "closing"
              },
              "eyebrow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "warning": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "title",
                  "text"
                ]
              },
              "points": {
                "default": [],
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 90
                }
              },
              "cta": {
                "type": "object",
                "properties": {
                  "save": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "description": "Llamado a guardar"
                  },
                  "question": {
                    "description": "Pregunta para comentarios",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 90
                  }
                },
                "required": [
                  "save"
                ]
              }
            },
            "required": [
              "type",
              "title",
              "cta"
            ]
          }
        ]
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2200,
      "description": "Texto principal del post"
    },
    "slideCaptions": {
      "description": "Un texto por lámina (opción de Instagram desde junio de 2026)",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "title",
          "url",
          "checkedAt"
        ]
      }
    }
  },
  "required": [
    "account",
    "topic",
    "infoDate",
    "slides",
    "caption",
    "sources"
  ]
}
