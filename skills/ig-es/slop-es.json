  "structures": [
    {
      "id": "relleno-marcado",
      "name": "Palabra o frase de relleno que hay que reescribir a mano",
      "regex": "(?i)(?<!\\w)(?:fascinante|apasionante|impresionante|increíble|crucial|imprescindible|a\\s+otro\\s+nivel|en\\s+la\\s+era\\s+de|en\\s+un\\s+mundo\\s+cada\\s+vez\\s+más|imagina\\s+un\\s+mundo|alguna\\s+vez\\s+te\\s+has\\s+preguntado|no\\s+vas\\s+a\\s+creer|el\\s+futuro\\s+es\\s+ahora|el\\s+futuro\\s+ya\\s+está\\s+aquí|lo\\s+mejor\\s+está\\s+por\\s+venir|sígueme\\s+para\\s+más|abro\\s+hilo|dale\\s+like)(?!\\w)",
      "fix": "Cámbiala por un dato o una palabra concreta. No se borra sola porque rompería la frase."
    },
    {
      "id": "no-solo",
      "name": "\"No es solo X, es Y\"",
      "regex": "(?i)\\bno (?:es|son|era|fue) (?:solo|sólo|solamente|simplemente) [^.!?\\n]{2,60}[,.;:]\\s*(?:es|son|era|fue)\\b",
      "fix": "Di la única cosa que quieres decir. Borra la mitad que prepara el giro."
    },
    {
      "id": "no-solo-sino",
      "name": "\"No solo X, sino también Y\"",
      "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
      "fix": "Sepáralo en dos frases o quédate con la mitad fuerte."
    },
    {
      "id": "no-se-trata",
      "name": "\"No se trata de X. Se trata de Y\"",
      "regex": "(?i)\\bno se trata (?:solo |sólo )?de [^.!?\\n]{2,60}[.,;:]\\s*se trata de\\b",
      "fix": "Empieza por Y. El giro es lo que delata la plantilla."
    },
    {
      "id": "el-resultado",
      "name": "Pregunta retórica de una línea (\"¿El resultado?\")",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|la clave|el truco|la trampa|lo peor|la respuesta|el problema)\\?\\s*$",
      "fix": "Dilo en la misma frase en vez de montar una revelación."
    },
    {
      "id": "spoiler",
      "name": "Apertura \"Spoiler:\"",
      "regex": "(?im)^\\s*spoiler\\s*:",
      "fix": "Di el dato sin anunciarlo."
    },
    {
      "id": "triada",
      "name": "Tríada de tres elementos",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
      "fix": "Dos o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "emojis-tipicos",
      "name": "Emojis de plantilla (cohete, fuego, foco, destellos, diana, dedo abajo)",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F447]",
      "fix": "Como mucho un emoji, y que no sea uno de estos."
    },
    {
      "id": "muro-hashtags",
      "name": "Muro de hashtags (6 o más)",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "fix": "Instagram cuenta hasta 5. Usa 3 a 5 temas específicos o ninguno."
    },
    {
      "id": "como-ia",
      "name": "El modelo hablando de sí mismo",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b,",
      "fix": "Borra la frase."
    },
    {
      "id": "cierre-ensayo",
      "name": "Cierre de ensayo (\"En resumen\")",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en definitiva|para cerrar)\\b",
      "fix": "Un post no necesita párrafo de conclusión."
    },
    {
      "id": "pregunta-cebo",
      "name": "Pregunta genérica de cierre",
      "regex": "(?im)(?:¿estás de acuerdo\\?|¿qué opinas\\?|¿qué piensas\\?|¿tú qué opinas\\?|¿me equivoco\\?|¿quién más\\b[^?\\n]*\\?)\\s*$",
      "fix": "Haz una pregunta que solo se puede hacer sobre este tema, con dos opciones concretas."
    },
    {
      "id": "deja-el-scroll",
      "name": "Apertura \"deja de hacer scroll\"",
      "regex": "(?im)^\\s*(?:deja de hacer scroll|no hagas scroll|no sigas bajando|espera,? no (?:pases|bajes))\\b",
      "fix": "El freno tiene que ser la afirmación misma. Pedir atención delata que no la ganaste."
    },
    {
      "id": "preambulo",
      "name": "Preámbulo (\"en este post te voy a...\")",
      "regex": "(?i)\\b(?:en este (?:video|post|carrusel|reel|hilo)(?: te)? (?:voy a|vas a|te (?:explico|cuento|enseño|muestro))|hoy te (?:voy a )?(?:enseñar|mostrar|explicar|contar)|te explico (?:cómo|qué|por qué)|te cuento (?:cómo|qué|por qué)|les traigo)\\b",
      "fix": "Bórralo y empieza por lo que ibas a mostrar."
    },
    {
      "id": "emoji-vinetas",
      "name": "Lista con emojis como viñetas",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF\\u2705\\u27A1\\u2B05\\u2714\\u2728\\u25B6\\u2794]\\s*\\S",
      "fix": "Usa guion o salto de línea. Las viñetas con emoji son lo más plantilla que hay en un texto."
    },
    {
      "id": "mayusculas",
      "name": "Tres o más palabras seguidas en mayúsculas",
      "regex": "\\b[A-ZÁÉÍÓÚÑ]{4,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{4,}\\b){2,}",
      "fix": "Las mayúsculas son volumen, no resaltador. Una palabra como mucho."
    },
    {
      "id": "cebo-cta",
      "name": "CTA genérico de cebo",
      "regex": "(?i)\\b(?:s[ií]gueme para m[aá]s|etiqueta a (?:alguien|un amigo|una amiga|tu amigo|ese amigo|esa amiga)|comp[aá]rt(?:e|elo|ela|irlo)(?: esto)? con (?:alguien|quien|ese amigo|esa amiga|tus amigos|un amigo)\\b[^.!?\\n]{0,30}necesit|dale (?:like|me gusta|corazón) si|comenta si|guarda (?:este post|esto) para (?:después|más tarde))",
      "fix": "Nombra la situación concreta: \"Mándaselo al de tu equipo que todavía...\". El cebo genérico enseña a ignorar todos los CTA."
    },
    {
      "id": "sabias-que",
      "name": "Apertura \"¿Sabías que...?\"",
      "regex": "(?im)^\\s*¿sab[ií]as que\\b",
      "fix": "Di el dato directamente, sin la pregunta."
    },
    {
      "id": "todo-lo-que",
      "name": "\"Todo lo que necesitas saber\"",
      "regex": "(?i)\\btodo lo que (?:necesitas|tienes que|debes) saber\\b",
      "fix": "Promete una cosa concreta, no todo."
    }
  ]
}
